{"commit":"859cafa71fc1e139c7b76d4d4c0f23438688a8ad","docs":{"cuckoo_insert":{"name":"cuckoo_insert","symbol":"CuckooHashTable::Insert","blurb":"The whole algorithm. One hash function is drawn per attempt, and only that one bucket is looked at.","file":"pir/hashing/cuckoo_hash_table.cc","commit":"859cafa71fc1e139c7b76d4d4c0f23438688a8ad","sourceSha256":"2928ee62b76129932641a1c99ac3e9ec99067acd4a968eddb59121487d2f340d","permalink":"https://github.com/google/distributed_point_functions/blob/859cafa71fc1e139c7b76d4d4c0f23438688a8ad/pir/hashing/cuckoo_hash_table.cc#L67-L90","startLine":67,"endLine":90,"lines":[{"n":67,"t":"absl::Status CuckooHashTable::Insert(absl::string_view input) {"},{"n":68,"t":"  std::string current_element(input);"},{"n":69,"t":"  for (int i = 0; i < max_relocations_; i++) {"},{"n":70,"t":"    // Choose a random hash function and hash the current element."},{"n":71,"t":"    int hash = hash_functions_[random_hash_function_(rng_)](current_element,"},{"n":72,"t":"                                                            num_buckets_);"},{"n":73,"t":"    if (table_[hash]) {"},{"n":74,"t":"      // If bucket is full, evict element and re-insert it recursively."},{"n":75,"t":"      std::swap(current_element, *table_[hash]);"},{"n":76,"t":"    } else {"},{"n":77,"t":"      // Otherwise just insert our current element and return."},{"n":78,"t":"      table_[hash] = std::move(current_element);"},{"n":79,"t":"      return absl::OkStatus();"},{"n":80,"t":"    }"},{"n":81,"t":"  }"},{"n":82,"t":"  // If we're still here after max_relocations_, put current_element on the"},{"n":83,"t":"  // stash."},{"n":84,"t":"  if (max_stash_size_ && stash_.size() >= *max_stash_size_) {"},{"n":85,"t":"    return absl::InternalError(\"Cannot insert element: stash is full\");"},{"n":86,"t":"  } else {"},{"n":87,"t":"    stash_.push_back(std::move(current_element));"},{"n":88,"t":"    return absl::OkStatus();"},{"n":89,"t":"  }"},{"n":90,"t":"}"}]},"cuckoo_create":{"name":"cuckoo_create","symbol":"CuckooHashTable::Create","blurb":"What the parameters must be. Two hash functions is the minimum, and a relocation budget of zero is legal.","file":"pir/hashing/cuckoo_hash_table.cc","commit":"859cafa71fc1e139c7b76d4d4c0f23438688a8ad","sourceSha256":"2928ee62b76129932641a1c99ac3e9ec99067acd4a968eddb59121487d2f340d","permalink":"https://github.com/google/distributed_point_functions/blob/859cafa71fc1e139c7b76d4d4c0f23438688a8ad/pir/hashing/cuckoo_hash_table.cc#L47-L65","startLine":47,"endLine":65,"lines":[{"n":47,"t":"absl::StatusOr<std::unique_ptr<CuckooHashTable>> CuckooHashTable::Create("},{"n":48,"t":"    std::vector<HashFunction> hash_functions, int num_buckets,"},{"n":49,"t":"    int max_relocations, absl::optional<int> max_stash_size) {"},{"n":50,"t":"  if (num_buckets <= 0) {"},{"n":51,"t":"    return absl::InvalidArgumentError(\"num_buckets must be positive\");"},{"n":52,"t":"  }"},{"n":53,"t":"  if (hash_functions.size() < 2) {"},{"n":54,"t":"    return absl::InvalidArgumentError("},{"n":55,"t":"        \"hash_functions.size() must be at least 2\");"},{"n":56,"t":"  }"},{"n":57,"t":"  if (max_relocations < 0) {"},{"n":58,"t":"    return absl::InvalidArgumentError(\"max_relocations must be non-negative\");"},{"n":59,"t":"  }"},{"n":60,"t":"  if (max_stash_size && *max_stash_size < 0) {"},{"n":61,"t":"    return absl::InvalidArgumentError(\"max_stash_size must be non-negative\");"},{"n":62,"t":"  }"},{"n":63,"t":"  return absl::WrapUnique(new CuckooHashTable("},{"n":64,"t":"      std::move(hash_functions), num_buckets, max_relocations, max_stash_size));"},{"n":65,"t":"}"}]},"sha256_hash":{"name":"sha256_hash","symbol":"SHA256HashFunction::operator()","blurb":"The digest becomes one 256-bit little-endian integer, then three divisions in base 2^64 reduce it.","file":"pir/hashing/sha256_hash_family.cc","commit":"859cafa71fc1e139c7b76d4d4c0f23438688a8ad","sourceSha256":"531d12f27c373e53be67cdb5939de4f4a2d6c54aeda5b1b0d532d57f21172666","permalink":"https://github.com/google/distributed_point_functions/blob/859cafa71fc1e139c7b76d4d4c0f23438688a8ad/pir/hashing/sha256_hash_family.cc#L59-L87","startLine":59,"endLine":87,"lines":[{"n":59,"t":"int SHA256HashFunction::operator()(absl::string_view input,"},{"n":60,"t":"                                   int upper_bound) const {"},{"n":61,"t":"  // Copy the default state on SHA256(seed)."},{"n":62,"t":"  SHA256_CTX ctx = ctx_;"},{"n":63,"t":"  // Compute the hash as SHA256(seed || input)."},{"n":64,"t":"  SHA256UpdateWithData(input, ctx);"},{"n":65,"t":"  // Finalize the SHA256 update and get the hash digest."},{"n":66,"t":"  char hash[SHA256_DIGEST_LENGTH];"},{"n":67,"t":"  SHA256_Final(reinterpret_cast<unsigned char*>(hash), &ctx);"},{"n":68,"t":""},{"n":69,"t":"  // Get the lower and upper 128-bits of the hash."},{"n":70,"t":"  absl::uint128 hi, lo;"},{"n":71,"t":"  constexpr size_t hi_offset = 16;"},{"n":72,"t":"  std::copy(reinterpret_cast<unsigned char*>(&hash[hi_offset]),"},{"n":73,"t":"            reinterpret_cast<unsigned char*>(&hash[hi_offset]) + hi_offset,"},{"n":74,"t":"            reinterpret_cast<unsigned char*>(&hi));"},{"n":75,"t":"  std::copy(reinterpret_cast<unsigned char*>(&hash[0]),"},{"n":76,"t":"            reinterpret_cast<unsigned char*>(&hash[0]) + hi_offset,"},{"n":77,"t":"            reinterpret_cast<unsigned char*>(&lo));"},{"n":78,"t":"  // Long division using 64-bit \"digits\" and absl::uint128 builtin division."},{"n":79,"t":"  absl::uint128 dividend1 = hi;"},{"n":80,"t":"  auto remainder1 = static_cast<uint64_t>(dividend1 % upper_bound);"},{"n":81,"t":"  absl::uint128 dividend2 ="},{"n":82,"t":"      absl::MakeUint128(remainder1, absl::Uint128High64(lo));"},{"n":83,"t":"  auto remainder2 = static_cast<uint64_t>(dividend2 % upper_bound);"},{"n":84,"t":"  absl::uint128 dividend3 ="},{"n":85,"t":"      absl::MakeUint128(remainder2, absl::Uint128Low64(lo));"},{"n":86,"t":"  return static_cast<int>(dividend3 % upper_bound);"},{"n":87,"t":"}"}]},"hash_family":{"name":"hash_family","symbol":"CreateHashFunctions","blurb":"Where the per-function seeds come from: the decimal index, as text.","file":"pir/hashing/hash_family.cc","commit":"859cafa71fc1e139c7b76d4d4c0f23438688a8ad","sourceSha256":"a421c1e9ccf40a5fa1b7d4c6f03b699432bdf67282628da5ec31aca2c58810e0","permalink":"https://github.com/google/distributed_point_functions/blob/859cafa71fc1e139c7b76d4d4c0f23438688a8ad/pir/hashing/hash_family.cc#L27-L39","startLine":27,"endLine":39,"lines":[{"n":27,"t":"absl::StatusOr<std::vector<HashFunction>> CreateHashFunctions("},{"n":28,"t":"    HashFamily hash_family, int num_hash_functions) {"},{"n":29,"t":"  if (num_hash_functions < 0) {"},{"n":30,"t":"    return absl::InvalidArgumentError("},{"n":31,"t":"        \"num_hash_functions must not be negative\");"},{"n":32,"t":"  }"},{"n":33,"t":"  std::vector<HashFunction> result;"},{"n":34,"t":"  result.reserve(num_hash_functions);"},{"n":35,"t":"  for (int i = 0; i < num_hash_functions; i++) {"},{"n":36,"t":"    result.push_back(hash_family(absl::StrCat(i)));"},{"n":37,"t":"  }"},{"n":38,"t":"  return result;"},{"n":39,"t":"}"}]},"mcht_insert":{"name":"mcht_insert","symbol":"MultipleChoiceHashTable::Insert","blurb":"All k buckets are measured, in order, and the least loaded one wins. Nothing is ever evicted.","file":"pir/hashing/multiple_choice_hash_table.cc","commit":"859cafa71fc1e139c7b76d4d4c0f23438688a8ad","sourceSha256":"14443592e5f012db6ab82c376484b24d4892c8b784ec068b2b88546dc08bc9b8","permalink":"https://github.com/google/distributed_point_functions/blob/859cafa71fc1e139c7b76d4d4c0f23438688a8ad/pir/hashing/multiple_choice_hash_table.cc#L57-L72","startLine":57,"endLine":72,"lines":[{"n":57,"t":"absl::Status MultipleChoiceHashTable::Insert(absl::string_view input) {"},{"n":58,"t":"  std::vector<int> hashes(hash_functions_.size());"},{"n":59,"t":"  int smallest_bucket = 0;"},{"n":60,"t":"  for (int i = 0; i < hash_functions_.size(); i++) {"},{"n":61,"t":"    hashes[i] = hash_functions_[i](input, num_buckets_);"},{"n":62,"t":"    if (i == 0 || table_[hashes[i]].size() < table_[smallest_bucket].size()) {"},{"n":63,"t":"      smallest_bucket = hashes[i];"},{"n":64,"t":"    }"},{"n":65,"t":"  }"},{"n":66,"t":"  if (max_bucket_size_ && table_[smallest_bucket].size() >= *max_bucket_size_) {"},{"n":67,"t":"    return absl::InternalError("},{"n":68,"t":"        \"Cannot insert element: maximum bucket size reached\");"},{"n":69,"t":"  }"},{"n":70,"t":"  table_[smallest_bucket].push_back(std::string(input));"},{"n":71,"t":"  return absl::OkStatus();"},{"n":72,"t":"}"}]},"simple_insert":{"name":"simple_insert","symbol":"SimpleHashTable::Insert","blurb":"Two loops: every candidate is measured first, then every candidate takes a copy.","file":"pir/hashing/simple_hash_table.cc","commit":"859cafa71fc1e139c7b76d4d4c0f23438688a8ad","sourceSha256":"b74d2ea0fbd98b240026f40e061568edd836b45898ecfcfc3eccdb6f33dceafa","permalink":"https://github.com/google/distributed_point_functions/blob/859cafa71fc1e139c7b76d4d4c0f23438688a8ad/pir/hashing/simple_hash_table.cc#L55-L70","startLine":55,"endLine":70,"lines":[{"n":55,"t":"absl::Status SimpleHashTable::Insert(absl::string_view input) {"},{"n":56,"t":"  std::vector<int> hashes(hash_functions_.size());"},{"n":57,"t":"  for (int i = 0; i < hash_functions_.size(); i++) {"},{"n":58,"t":"    hashes[i] = hash_functions_[i](input, num_buckets_);"},{"n":59,"t":"    if (max_bucket_size_ && table_[hashes[i]].size() >= *max_bucket_size_) {"},{"n":60,"t":"      return absl::InternalError("},{"n":61,"t":"          \"Cannot insert element: maximum bucket size reached\");"},{"n":62,"t":"    }"},{"n":63,"t":"  }"},{"n":64,"t":"  // Second loop to ensure that an element is either inserted into all buckets,"},{"n":65,"t":"  // or none in case of an error."},{"n":66,"t":"  for (int i = 0; i < hash_functions_.size(); i++) {"},{"n":67,"t":"    table_[hashes[i]].push_back(std::string(input));"},{"n":68,"t":"  }"},{